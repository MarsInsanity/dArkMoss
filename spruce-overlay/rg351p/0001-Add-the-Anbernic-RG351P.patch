diff --git a/spruce/scripts/platform/darkmoss/RG351P.cfg b/spruce/scripts/platform/darkmoss/RG351P.cfg
new file mode 100644
index 00000000..4f52082a
--- /dev/null
+++ b/spruce/scripts/platform/darkmoss/RG351P.cfg
@@ -0,0 +1,192 @@
+#!/bin/sh
+# Anbernic RG351P (RK3326, 320x480 portrait panel shown as 480x320) on
+# dArkMoss's rg351p unit: the rg351 kernel with rk3326-rg351p-linux.dtb. Same
+# panel, SoC, PMIC and codec as the V10, so display, CPU and audio follow
+# V10.cfg. The pad is NOT the V10's: it is an internal USB HID controller,
+# "OpenSimHardware OSH PB Controller" (1209:3100), with the d-pad on a hat.
+# Button codes are ArkOS's RG351P EmulationStation config (es_input.cfg,
+# GUID 03000000091200000031000011010000). One SD slot: spruce lives on the
+# SPRUCEOS partition firstboot adds to TF1.
+
+. /mnt/SDCARD/spruce/scripts/platform/darkmoss/dArkMossCommon.cfg
+
+
+  #################################
+#####   IDENTITY AND FIRMWARE   #####
+  #################################
+
+export BRAND="Anbernic"
+export SPRUCE_DEVICE_NAME="Anbernic RG351P"
+export SYSTEM_JSON="/mnt/SDCARD/Saves/rg351p-system.json"
+export SYSTEM_JSON_DEFAULT="/mnt/SDCARD/App/PyUI/main-ui/devices/darkmoss/json/rg351p-system.json"
+
+  ###################################
+#####   DISPLAY CHARACTERISTICS   #####
+  ###################################
+
+# Physically 320x480 portrait (fbcon=rotate:3), as on the V10: dArkMoss
+# installs the odroidgoa RGA ROT_270 SDL for this unit and PyUI turns its own
+# frames, so everything else renders landscape with no rotation of its own.
+export DISPLAY_WIDTH="480"
+export DISPLAY_HEIGHT="320"
+export DISPLAY_ROTATION="0"
+export DISPLAY_ASPECT_RATIO="3:2"
+export DISPLAY_TEXT_ELF_WIDTH="450"
+
+  ########################
+#####   CPU SETTINGS   #####
+  ########################
+
+# RK3326, as the V10 (see V10.cfg for why interactive with a 1008 MHz floor).
+export DEVICE_POWERSAVE_LOW_FREQ=816000
+export DEVICE_POWERSAVE_HIGH_FREQ=1008000
+
+export CPU_SMART_GOVENOR="interactive"
+export CPU_SMART_MIN_FREQ=1008000
+export CPU_SMART_FLOOR_FREQ=1008000
+export CPU_SMART_MAX_FREQ=1296000
+export CPU_PERF_MAX_FREQ=1296000
+export CPU_OVERCLOCK_MAX_FREQ=1296000
+
+export GPU_GOVENOR_DIR="/sys/devices/platform/ff400000.gpu/devfreq/ff400000.gpu"
+export GPU_SMART_MAX_FREQ="520000000"
+export GPU_PERFORMANCE_MAX_FREQ="520000000"
+export GPU_OVERCLOCK_MAX_FREQ="520000000"
+
+export DRAM_DEVFREQ_DIR="/sys/class/devfreq/dmc"
+export DRAM_POWERSAVE_GOVERNOR="pin"
+export DRAM_SMART_GOVERNOR="pin"
+export DRAM_PERFORMANCE_GOVERNOR="pin"
+export DRAM_OVERCLOCK_GOVERNOR="pin"
+
+export PSP_BIN="PPSSPPSDL_dArkMoss3326"
+
+  ##################################################
+#####   OTHER HARDWARE FEATURES AND INTERFACES   #####
+  ##################################################
+
+export AUDIO_PATH_SPK="SPK"
+export AUDIO_PATH_HP="HP"
+export VOLUME_CONTROL="Playback"
+export DARKMOSS_VOLUME_READ_MAPPED=1
+export DARKMOSS_SEED_SYSTEM_JSON=1
+# One stick (left). RetroArch and the emulators read it; the spruce menus use
+# the d-pad only (see rg351p.py).
+export DEVICE_NUM_ANALOG_STICKS=1
+export DEVICE_SUPPORTS_PORTMASTER="true"
+
+# The rumble motor is on pwm0 (GPIO0_B7), not a force-feedback pad: RG351P.sh's
+# vibrate drives it through sysfs.
+export RG351P_PWM_CHIP="/sys/class/pwm/pwmchip0"
+
+  ######################################
+#####   KEY CODES AND INPUT EVENTS   #####
+  ######################################
+
+# A USB device: no fixed by-path link, so find it by name.
+export PAD_NODE_CANDIDATES=""
+export PAD_NAME_CANDIDATES="OpenSimHardware OSH PB Controller"
+_rg351p_pad=""
+for _rg351p_dir in /sys/class/input/event*; do
+    if [ "$(cat "$_rg351p_dir/device/name" 2>/dev/null)" = "OpenSimHardware OSH PB Controller" ]; then
+        _rg351p_pad="/dev/input/${_rg351p_dir##*/}"
+        break
+    fi
+done
+export EVENT_PATH_READ_INPUTS_SPRUCE="${_rg351p_pad:-/dev/input/event2}"
+unset _rg351p_pad _rg351p_dir
+export EVENT_PATH_SEND_TO_RA_AND_PPSSPP="$EVENT_PATH_READ_INPUTS_SPRUCE"
+export EVENT_PATH_SEND_TO_DRASTIC="$EVENT_PATH_READ_INPUTS_SPRUCE"
+
+# Power key: rk8xx_pwrkey (resolve_key_event_node finds it by name). The
+# volume buttons are not on the pad; dArkMossCommon's resolve_key_event_node
+# finds the node that reports KEY_VOLUMEUP/DOWN, if the kernel has one.
+export EVENT_PATH_POWER="/dev/input/event0"
+export EVENT_PATH_VOLUME="$EVENT_PATH_POWER"
+export SPRUCE_INPUT_NODES_FILE="/tmp/rg351p_input_nodes"
+[ -f "$SPRUCE_INPUT_NODES_FILE" ] && . "$SPRUCE_INPUT_NODES_FILE"
+
+# D-pad: ABS_HAT0X (16) / ABS_HAT0Y (17), as the Anbernic XX line.
+export B_UP="3 17 -1"    # negative for up
+export B_DOWN="3 17 1"
+export B_LEFT="3 16 -1"  # negative for left
+export B_RIGHT="3 16 1"
+
+# Physical labels: A is the right face button, B the bottom one.
+export B_A="1 304"
+export B_B="1 305"
+export B_X="1 306"
+export B_Y="1 307"
+
+export B_L1="1 308"
+export B_R1="1 309"
+export B_L2="1 314"
+export B_R2="1 315"
+
+export B_SELECT="1 311"
+export B_START="1 310"
+# Volume is a hardware wheel after the codec, not a key: spruce keeps the
+# codec at full (RG351P.sh's set_volume). These are KEY_VOLUMEUP/DOWN, which
+# nothing on the RG351P reports; not DOESNT_EXIST, which would turn SELECT+L3/R3
+# into volume chords in buttons_watchdog.sh.
+export B_VOLUP="1 115"
+export B_VOLDOWN="1 114"
+
+# No menu button: the stick click (312) is MENU, and SELECT+START in the menus
+# (rg351p.py). As on the RGB30 with its menu on a stick click, L3 is then
+# DOESNT_EXIST, and it has to be here: the pad is a HID keyboard and the kernel
+# autorepeats it, so holding the click sends "1 312 2", which matched
+# menubutton_watchdog.sh's "key $B_L3" cancel and cancelled its own press
+# (seen on hardware: every press logged, no tap or hold action). R3 is
+# reported by the controller, but the RG351P has no second stick.
+export B_MENU="1 312"
+export B_L3="DOESNT_EXIST"
+export B_R3="DOESNT_EXIST"
+export B_HOME="DOESNT_EXIST"
+
+# gamecontrollerdb's entry for this pad, with A/B and X/Y label-named like the
+# other dArkMoss units (a:b0 is 304, the button marked A).
+export SDL_GAMECONTROLLER_MAP="03000000091200000031000011010000,OpenSimHardware OSH PB Controller,a:b0,b:b1,x:b2,y:b3,leftshoulder:b4,rightshoulder:b5,start:b6,back:b7,leftstick:b8,rightstick:b9,lefttrigger:b10,righttrigger:b11,dpup:h0.1,dpdown:h0.4,dpleft:h0.8,dpright:h0.2,leftx:a0~,lefty:a1~,platform:Linux,"
+
+export STICK_LEFT="DOESNT_EXIST"
+export STICK_RIGHT="DOESNT_EXIST"
+export STICK_UP="DOESNT_EXIST"
+export STICK_DOWN="DOESNT_EXIST"
+
+  ###############
+#####   HDMI   #####
+  ###############
+
+export HDMI_STATE_PATH=""
+export HEADPHONE_STATE_PATH=""
+
+  ##############################
+#####   BRIGHTNESS MAPPING   #####
+  ##############################
+
+# rk3326-rg351p-linux.dts: pwm backlight, levels 0-255.
+export SYSTEM_BACKLIGHT_LEVEL_0="5"
