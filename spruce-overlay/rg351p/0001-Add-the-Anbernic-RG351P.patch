diff --git a/RetroArch/.retroarch/autoconfig/udev/OpenSimHardware OSH PB Controller.cfg b/RetroArch/.retroarch/autoconfig/udev/OpenSimHardware OSH PB Controller.cfg
new file mode 100644
index 00000000..1954a09f
--- /dev/null
+++ b/RetroArch/.retroarch/autoconfig/udev/OpenSimHardware OSH PB Controller.cfg	
@@ -0,0 +1,56 @@
+# Anbernic RG351P internal pad: a USB HID controller (1209:3100), d-pad on a
+# hat. A is the right face button. Numbering is RetroArch's udev joypad driver
+# (input/drivers_joypad/udev_joypad.c), which numbers KEY_UP..KEY_DOWN first,
+# then every key from BTN_MISC up. This pad also declares those six arrow keys
+# and nine mouse buttons (272-280), so its buttons 304-315 are 15-26, not the
+# 0-11 of ArkOS's older RetroArch (checked on hardware: with 0-11 only the hat
+# d-pad and the stick worked).
+input_driver = "udev"
+input_device = "OpenSimHardware OSH PB Controller"
+input_vendor_id = "4617"
+input_product_id = "12544"
+
+input_a_btn = "15"
+input_b_btn = "16"
+input_x_btn = "17"
+input_y_btn = "18"
+
+input_l_btn = "19"
